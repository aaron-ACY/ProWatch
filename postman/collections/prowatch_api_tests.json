      "name": "1. Web Dashboard APIs (:3000)",
      "item": [
        {
          "name": "Get AI Model Integration Status",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{web_url}}/api/integration",
              "host": [
                "{{web_url}}"
              ],
              "path": [
                "api",
                "integration"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response is valid JSON with SUCCESS status', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.be.an('object');",
                  "    pm.expect(jsonData.status).to.eql('SUCCESS');",
                  "    pm.expect(jsonData.model_info).to.have.property('model_name');",
                  "});"
                ]
              }
            }
          ],
          "id": "2f05ea78-e67e-4007-8efb-ee72c4570bbd"
        },
