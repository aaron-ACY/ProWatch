{
  "java.configuration.updateBuildConfiguration": "disabled",
  "java.import.gradle.enabled": false,
  "java.import.maven.enabled": true,
  "java.import.exclusions": [
    "**/node_modules/**",
    "**/frontend/**",
    "**/.metadata/**",
    "**/archetype/**"
  ],
  "files.exclude": {
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/CVS": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/target": true
  },
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/target/**": true
  },
  "java.compile.nullAnalysis.mode": "automatic",
  "python.analysis.extraPaths": [
    "model/ref/src",
    "model/smartwatch/src"
  ],
  "python.defaultInterpreterPath": "${workspaceFolder}/model/smartwatch/.venv/Scripts/python.exe"
}